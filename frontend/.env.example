# Copy to `.env` only if you need to override the default.
#
# WARNING: everything here is inlined into the JavaScript bundle at build time
# and is therefore public. Never put secrets in a frontend env file.
#
# Vite only exposes variables prefixed with VITE_.

# Host (and port) of the Django backend, without the scheme.
# Leave empty in development: the app then talks to the same host the page was
# served from, on port 8000, which is what makes it work from a phone on the LAN.
# In production set it to the deployed backend, e.g. api.example.com
VITE_BACKEND_HOST=
