# Copy to `.env` for local development. In production set these as real
# environment variables on the host instead: no .env file gets deployed.

# Required when DJANGO_DEBUG=False, optional in development.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True in development, False everywhere else.
DJANGO_DEBUG=True

# Comma separated, required when DJANGO_DEBUG=False. Ignored in development,
# where every host is allowed so phones on the LAN can reach the dev server.
DJANGO_ALLOWED_HOSTS=
